{
  "Environment": "Development",
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://*:8080"
      }
    }
  },
  "Logging": {
    "Console": {
      "TimestampFormat": "[dd/MM/yy HH:mm:ss] "
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft": "Error",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Tags": {
      "INFO": true,
      "DEBUG": true,
      "ERROR": true,
      "WARN": true,
      "CRITICAL": true
    }
  }
}
